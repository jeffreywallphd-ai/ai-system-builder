  "environments": {
    "representative-participants": "At least five representative nondeveloper participants, consent and synthetic task scripts; no participant records or session content in repository evidence.",
    "manual-assistive-technology": "Named supported desktop and thin-client profiles, actual keyboard and screen-reader operators, 320 CSS-pixel reflow, focus/contrast/noncolor/reduced-motion checks.",
    "private-provider-credentials": "Separately authorized private provider test repository and credentials; real commit/render/retry/denial/cleanup evidence without retained credentials.",
    "representative-scale-fixtures": "Approved multi-gigabyte synthetic sources and test website/provider; measured bytes, RSS, resume/cancel and cleanup.",
    "installed-models-and-hardware": "Authorized already-installed model identities and representative CPU/accelerator/constrained-memory cohorts; held-out quality and actual RAM/VRAM/throughput measurements.",
    "reference-performance-profiles": "Named reference desktop and managed-server/thin-client performance environments; cold/warm and transport effects declared.",
    "whole-host-runtime-profiles": "Controlled desktop and server/thin-client runtime leave/reopen/disconnect/cancel/failure/shutdown measurements with physical worker cleanup evidence.",
    "controlled-security-target": "Authorized disposable target-environment security assessment; source review alone is insufficient.",
    "ocr-supported-runtime": "OCR remains explicitly unavailable; do not declare advanced qualification passed from hardware availability alone."
  },
  "targets": {
    "participants": 5,
    "critical_journey_success_minimum": 4,
    "critical_data_loss_or_authority_confusion": 0,
    "median_task_ease_minimum_out_of_7": 5,
    "accepted_output_throughput_improvement_minimum_percent": 20,
    "quality": "Predeclare held-out metric and statistical tolerance per task; no material quality regression. CPU/accelerator and constrained/unchecked cohorts remain separate."
  }
